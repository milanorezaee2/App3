{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_LEARNER_LOGIN": "false",
        "EXPO_PUBLIC_SKIP_COMPANION_ONBOARDING": "false"
      }
    },
    "production": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_LEARNER_LOGIN": "false",
        "EXPO_PUBLIC_SKIP_COMPANION_ONBOARDING": "false"
      }
    },
    "admin": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "MILO_ADMIN_APP": "true",
        "EXPO_PUBLIC_MILO_ADMIN_APP": "true",
        "EXPO_PUBLIC_ENABLE_EDUCATION_ADMIN": "true",
        "EXPO_PUBLIC_LEARNER_LOGIN": "false",
        "EXPO_PUBLIC_LANGUAGE_SCOPE": "en,tr",
        "EXPO_PUBLIC_SKIP_COMPANION_ONBOARDING": "false"
      }
    },
    "learner": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_MILO_ADMIN_APP": "false",
        "EXPO_PUBLIC_ENABLE_EDUCATION_ADMIN": "false",
        "EXPO_PUBLIC_LEARNER_LOGIN": "false",
        "EXPO_PUBLIC_LANGUAGE_SCOPE": "en,ru,de,fr,es",
        "EXPO_PUBLIC_SKIP_COMPANION_ONBOARDING": "false"
      }
    },
    "learner-tr": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_MILO_ADMIN_APP": "false",
        "EXPO_PUBLIC_ENABLE_EDUCATION_ADMIN": "false",
        "EXPO_PUBLIC_LEARNER_LOGIN": "false",
        "EXPO_PUBLIC_LANGUAGE_SCOPE": "en,tr",
        "EXPO_PUBLIC_SKIP_COMPANION_ONBOARDING": "false"
      }
    }
  }
}
