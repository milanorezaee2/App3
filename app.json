{
  "expo": {
    "name": "MiloMultiLanguage",
    "slug": "companion-english",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "companionenglish",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.devicecontrol.companion",
      "versionCode": 11,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F7F2E8"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withStableLayoutDirection",
      "./plugins/withLightTextTheme",
      "./plugins/withAndroidAbis",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#2878DE",
          "defaultChannel": "milo-chat"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "برای بازکردن قفل برنامه، اجازه استفاده از Face ID را بدهید."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5FAFF",
          "image": "./assets/images/splash-learning-light.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#F5FAFF",
            "image": "./assets/images/splash-learning-light.png"
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "برای تمرین تلفظ جمله‌ها، اجازه استفاده از میکروفن را بدهید."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "برای تمرین گفتاری، اجازه استفاده از میکروفن را بدهید.",
          "speechRecognitionPermission": "برای بررسی گفتار شما، اجازه تشخیص گفتار را بدهید.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "packagingOptions": {
              "pickFirst": [
                "**/libc++_shared.so",
                "**/libjsc.so",
                "**/libfbjni.so"
              ]
            },
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      "expo-task-manager",
      "expo-background-task"
    ],
    "experiments": {
      "baseUrl": "/App3",
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "sitemap": false
      },
      "eas": {
        "projectId": "be0e368c-0d94-4e95-b4f4-d757fa7beb42"
      }
    }
  }
}
